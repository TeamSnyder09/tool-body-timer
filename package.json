{
  "name": "tool-body-timer-web",
  "version": "1.0.0",
  "description": "Multi-user web application for tracking tool body runtime",
  "main": "dist/server/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc && npm run copy-static",
    "copy-static": "copyfiles -u 1 \"src/client/**/*.html\" \"src/client/**/*.css\" \"src/client/**/*.js\" dist",
    "start": "node dist/server/index.js",
    "dev": "concurrently \"tsc -w\" \"nodemon dist/server/index.js\"",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1"
  },
  "author": "",
  "license": "MIT"
}